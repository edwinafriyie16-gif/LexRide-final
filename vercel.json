{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth?path=:path*" },
    { "source": "/api/rides/:path*", "destination": "/api/rides?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
